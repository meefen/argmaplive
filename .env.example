# Copy to .env and fill in. Keep .env private: chmod 600 .env (git ignores it).
# A shell environment variable with the same name overrides a line here.

# Gemini API key, used only with mine-transcript.py --gemini
# (create one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# whisper.cpp, for live-captions.py
WHISPER_CPP_DIR=~/src/whisper.cpp
WHISPER_MODEL=models/ggml-large-v3-turbo.bin   # relative to WHISPER_CPP_DIR
MIC=                                           # part of a microphone name, e.g. Logi; empty: default mic

# Local LLM, the default for mine-transcript.py (nothing leaves this machine)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b-mlx

# Gemini, used only with mine-transcript.py --gemini
GEMINI_MODEL=gemini-4-hydrogen

# mined-to-site.py: folder with quickdoc.css, theme.html and one folder per site
SITE_DIR=~/src/quick-docs
